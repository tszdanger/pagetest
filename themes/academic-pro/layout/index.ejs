<!-- Publications Section -->
<section id="publications" class="section">
  <div class="container">
    <h2 class="section-title">Publications</h2>
    <p class="section-subtitle"><i class="fas fa-trophy"></i> <strong>CCF-A</strong> denotes top-tier venues in Computer Science. * equal contribution.</p>
    <%
      var pubData = site.data.publications || [];
      var years = {};
      pubData.forEach(function(pub) {
        var year = pub.year || '';
        if (!years[year]) years[year] = [];
        years[year].push(pub);
      });
      var sortedYears = Object.keys(years).sort(function(a,b){ return Number(b) - Number(a); });
    %>
    <% sortedYears.forEach(function(year) { %>
    <div class="pub-year-group">
      <h3 class="pub-year"><%= year %></h3>
      <% years[year].forEach(function(pub, i) { %>
      <div class="pub-item">
        <div class="pub-badge"><%= pub.venue_short || 'PUB' %></div>
        <div class="pub-info">
          <h4 class="pub-title">
            <% if (pub.paper_url && pub.paper_url !== '#') { %><a href="<%= pub.paper_url %>" target="_blank" rel="noopener"><% } %>
            <%= pub.title %>
            <% if (pub.paper_url && pub.paper_url !== '#') { %></a><% } %>
          </h4>
          <p class="pub-authors"><%- pub.authors || '' %></p>
          <p class="pub-venue">
            <%- pub.venue || '' %>
            <% if (pub.location_date) { %><span class="pub-location"> &mdash; <%= pub.location_date %></span><% } %>
          </p>
        </div>
      </div>
      <% }); %>
    </div>
    <% }); %>
  </div>
</section>

