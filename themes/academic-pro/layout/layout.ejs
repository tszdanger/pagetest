<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
  <link rel="icon" type="image/png" href="<%= url_for('/img/favicon.png') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
</head>
<body>
  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <a href="<%= url_for('/') %>" class="nav-brand"><%= config.author %></a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#about" class="nav-link">About</a></li>
        <li><a href="#education" class="nav-link">Education</a></li>
        <li><a href="#publications" class="nav-link">Publications</a></li>
        <li><a href="#honors" class="nav-link">Honors</a></li>
        <li><a href="#service" class="nav-link">Service</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <%- body %>
  </main>

  <footer class="footer">
    <div class="footer-container">
      <div class="footer-social">
        <a href="https://github.com/tszdanger" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a>
        <a href="https://scholar.google.com/citations?user=Sd8mmE0AAAAJ" target="_blank" rel="noopener" aria-label="Google Scholar"><i class="fas fa-graduation-cap"></i></a>
        <a href="https://www.linkedin.com/in/%E5%AE%97%E6%9D%B0-%E6%9D%8E-ba44291a2/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
        <a href="https://orcid.org/0000-0002-9897-4086" target="_blank" rel="noopener" aria-label="ORCID"><i class="fab fa-orcid"></i></a>
        <a href="mailto:zligo@cse.ust.hk" aria-label="Email"><i class="fas fa-envelope"></i></a>
      </div>
      <p class="footer-copy">&copy; <%= date(Date.now(), 'YYYY') %> <%= config.author %></p>
    </div>
  </footer>

  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
